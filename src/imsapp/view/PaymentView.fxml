<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.control.cell.PropertyValueFactory?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<?import de.jensd.fx.glyphs.fontawesome.FontAwesomeIconView?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="imsapp.controller.PaymentController"
      spacing="0" styleClass="module-pane">
    <padding><Insets top="22" right="24" bottom="16" left="24"/></padding>

    <!-- PAGE HEADER -->
    <HBox alignment="CENTER_LEFT" spacing="10">
        <StackPane style="-fx-background-color:rgba(59,130,246,0.1);-fx-background-radius:8;-fx-padding:8;">
            <FontAwesomeIconView glyphName="CREDIT_CARD" size="1.2em" fill="#3b82f6"/>
        </StackPane>
        <VBox spacing="2">
            <Label text="Payments" styleClass="module-title"/>
            <Label fx:id="lblMode" text="＋  New Payment Record" styleClass="mode-label"/>
        </VBox>
    </HBox>
    <VBox.margin><Insets bottom="14"/></VBox.margin>

    <!-- FORM CARD -->
    <VBox styleClass="form-card" spacing="0">
        <VBox.margin><Insets bottom="12"/></VBox.margin>

        <Label text="TRANSACTION SOURCE" styleClass="section-header"/>

        <GridPane hgap="14" vgap="8" styleClass="form-grid">
            <VBox.margin><Insets top="8"/></VBox.margin>

            <Label text="Customer" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
            <ComboBox fx:id="cmbCustomer" promptText="Select customer"
                      GridPane.rowIndex="0" GridPane.columnIndex="1" prefWidth="220"/>

            <Label text="Vehicle" GridPane.rowIndex="0" GridPane.columnIndex="2"/>
            <ComboBox fx:id="cmbVehicle" promptText="Select vehicle (optional)"
                      GridPane.rowIndex="0" GridPane.columnIndex="3" prefWidth="220"/>

            <Label text="PAYMENT DETAILS" styleClass="section-header"
                   GridPane.rowIndex="1" GridPane.columnIndex="0" GridPane.columnSpan="4"/>

            <Label text="Payment Type" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
            <ComboBox fx:id="cmbPaymentType" promptText="Select type"
                      GridPane.rowIndex="2" GridPane.columnIndex="1" prefWidth="220"/>

            <Label text="Method" GridPane.rowIndex="2" GridPane.columnIndex="2"/>
            <ComboBox fx:id="cmbPaymentMethod" promptText="Select method"
                      GridPane.rowIndex="2" GridPane.columnIndex="3" prefWidth="220"/>

            <Label text="Amount (₱)" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
            <TextField fx:id="txtAmount" promptText="0.00"
                       GridPane.rowIndex="3" GridPane.columnIndex="1" prefWidth="220"/>

            <Label text="Remarks" GridPane.rowIndex="3" GridPane.columnIndex="2"/>
            <TextField fx:id="txtRemarks" promptText="Optional notes"
                       GridPane.rowIndex="3" GridPane.columnIndex="3" prefWidth="220"/>

            <columnConstraints>
                <ColumnConstraints minWidth="110" prefWidth="130"/>
                <ColumnConstraints hgrow="ALWAYS" fillWidth="true"/>
                <ColumnConstraints minWidth="110" prefWidth="130"/>
                <ColumnConstraints hgrow="ALWAYS" fillWidth="true"/>
            </columnConstraints>
        </GridPane>
    </VBox>

    <!-- ACTION BAR -->
    <HBox spacing="8" alignment="CENTER_LEFT" styleClass="action-bar">
        <VBox.margin><Insets bottom="10"/></VBox.margin>
        <Button fx:id="btnSavePayment" text=" Save Payment" styleClass="btn-primary" onAction="#handleSavePayment">
            <graphic><FontAwesomeIconView glyphName="SAVE" fill="white" size="0.9em"/></graphic>
        </Button>
        <Button fx:id="btnDelete" text=" Delete" styleClass="btn-danger" onAction="#handleDelete">
            <graphic><FontAwesomeIconView glyphName="TRASH" fill="#6b7280" size="0.9em"/></graphic>
        </Button>
        <Button text=" Clear" styleClass="btn-outline" onAction="#handleClear">
            <graphic><FontAwesomeIconView glyphName="ERASER" fill="#374151" size="0.9em"/></graphic>
        </Button>
        <Button text=" Export CSV" styleClass="btn-outline" onAction="#handleExport">
            <graphic><FontAwesomeIconView glyphName="DOWNLOAD" fill="#374151" size="0.9em"/></graphic>
        </Button>
        <Region HBox.hgrow="ALWAYS"/>
        <HBox styleClass="search-container" alignment="CENTER_LEFT" spacing="6">
            <FontAwesomeIconView glyphName="SEARCH" fill="#1e3a5f" size="0.85em"/>
            <TextField fx:id="txtSearch" promptText="Search transaction ID, type, method…"
                       styleClass="search-field" prefWidth="240"/>
        </HBox>
    </HBox>

    <!-- TABLE -->
    <TableView fx:id="tblPayments" VBox.vgrow="ALWAYS" styleClass="data-table">
        <placeholder>
            <Label text="No payment records yet — fill in the form above and click Save Payment"/>
        </placeholder>
        <columns>
            <TableColumn text="TRANSACTION ID" prefWidth="160">
                <cellValueFactory><PropertyValueFactory property="transactionId"/></cellValueFactory>
            </TableColumn>
            <TableColumn text="TYPE" prefWidth="110">
                <cellValueFactory><PropertyValueFactory property="paymentType"/></cellValueFactory>
            </TableColumn>
            <TableColumn text="METHOD" prefWidth="110">
                <cellValueFactory><PropertyValueFactory property="paymentMethod"/></cellValueFactory>
            </TableColumn>
            <TableColumn text="AMOUNT (₱)" prefWidth="110">
                <cellValueFactory><PropertyValueFactory property="amount"/></cellValueFactory>
            </TableColumn>
            <TableColumn text="DATE" prefWidth="160">
                <cellValueFactory><PropertyValueFactory property="paymentDate"/></cellValueFactory>
            </TableColumn>
            <TableColumn text="REMARKS" prefWidth="180">
                <cellValueFactory><PropertyValueFactory property="remarks"/></cellValueFactory>
            </TableColumn>
        </columns>
    </TableView>
    <Label fx:id="lblRecordCount" text="" styleClass="record-count-label"/>
</VBox>
