<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.control.cell.PropertyValueFactory?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<?import de.jensd.fx.glyphs.fontawesome.FontAwesomeIconView?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="imsapp.controller.UserManagementController"
      spacing="16" styleClass="module-pane">
    <padding><Insets top="20" right="24" bottom="20" left="24"/></padding>

    <Label text="User Management" styleClass="module-title"/>
    <Label fx:id="lblMode" text="＋  Create New Account" styleClass="mode-label"/>

    <!-- FORM -->
    <GridPane hgap="12" vgap="10" styleClass="form-grid">
        <Label text="Account Details" styleClass="section-header"
               GridPane.rowIndex="0" GridPane.columnIndex="0" GridPane.columnSpan="4"/>

        <Label text="Full Name:" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
        <TextField fx:id="txtFullName" promptText="e.g. Juan dela Cruz"
                   GridPane.rowIndex="1" GridPane.columnIndex="1" prefWidth="220"/>

        <Label text="Username:" GridPane.rowIndex="1" GridPane.columnIndex="2"/>
        <TextField fx:id="txtUsername" promptText="Login username"
                   GridPane.rowIndex="1" GridPane.columnIndex="3" prefWidth="220"/>

        <Label text="Role:" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
        <ComboBox fx:id="cmbRole" GridPane.rowIndex="2" GridPane.columnIndex="1" prefWidth="220"/>

        <Label text="Status:" GridPane.rowIndex="2" GridPane.columnIndex="2"/>
        <ComboBox fx:id="cmbStatus" GridPane.rowIndex="2" GridPane.columnIndex="3" prefWidth="220"/>

        <Label text="Password Section" styleClass="section-header"
               GridPane.rowIndex="3" GridPane.columnIndex="0" GridPane.columnSpan="4">
            <GridPane.margin><Insets top="10"/></GridPane.margin>
        </Label>

        <Label text="New Password:" GridPane.rowIndex="4" GridPane.columnIndex="0"/>
        <PasswordField fx:id="txtPassword" promptText="Leave blank to keep existing"
                       GridPane.rowIndex="4" GridPane.columnIndex="1" prefWidth="220"/>

        <Label text="Confirm Password:" GridPane.rowIndex="4" GridPane.columnIndex="2"/>
        <PasswordField fx:id="txtConfirmPassword" promptText="Re-enter password"
                       GridPane.rowIndex="4" GridPane.columnIndex="3" prefWidth="220"/>
    </GridPane>

    <!-- BUTTONS -->
    <HBox spacing="10" alignment="CENTER_LEFT">
        <Button fx:id="btnCreate" text=" Create Account" styleClass="btn-primary" onAction="#handleCreate">
            <graphic><FontAwesomeIconView glyphName="USER_PLUS" fill="white"/></graphic>
        </Button>
        <Button fx:id="btnUpdate" text=" Update" styleClass="btn-secondary" onAction="#handleUpdate">
            <graphic><FontAwesomeIconView glyphName="EDIT" fill="#a8b2d1"/></graphic>
        </Button>
        <Button fx:id="btnResetPw" text=" Reset Password" styleClass="btn-secondary" onAction="#handleResetPassword">
            <graphic><FontAwesomeIconView glyphName="KEY" fill="#a8b2d1"/></graphic>
        </Button>
        <Button fx:id="btnDelete" text=" Delete" styleClass="btn-danger" onAction="#handleDelete">
            <graphic><FontAwesomeIconView glyphName="TRASH" fill="#e94560"/></graphic>
        </Button>
        <Button text=" Clear" styleClass="btn-outline" onAction="#handleClear">
            <graphic><FontAwesomeIconView glyphName="ERASER" fill="#8892b0"/></graphic>
        </Button>
        <Region HBox.hgrow="ALWAYS"/>
        <HBox alignment="CENTER" spacing="5">
            <FontAwesomeIconView glyphName="SEARCH" fill="#8892b0"/>
            <TextField fx:id="txtSearch" promptText="Search users..." prefWidth="220"/>
        </HBox>
    </HBox>

    <!-- TABLE -->
    <TableView fx:id="tblUsers" VBox.vgrow="ALWAYS" styleClass="data-table">
        <placeholder>
            <Label text="No user accounts found."/>
        </placeholder>
        <columns>
            <TableColumn text="ID" prefWidth="45">
                <cellValueFactory><PropertyValueFactory property="userId"/></cellValueFactory>
            </TableColumn>
            <TableColumn text="Full Name" prefWidth="180">
                <cellValueFactory><PropertyValueFactory property="fullName"/></cellValueFactory>
            </TableColumn>
            <TableColumn text="Username" prefWidth="140">
                <cellValueFactory><PropertyValueFactory property="username"/></cellValueFactory>
            </TableColumn>
            <TableColumn text="Role" prefWidth="100">
                <cellValueFactory><PropertyValueFactory property="role"/></cellValueFactory>
            </TableColumn>
            <TableColumn text="Active" prefWidth="80">
                <cellValueFactory><PropertyValueFactory property="active"/></cellValueFactory>
            </TableColumn>
        </columns>
    </TableView>
    <Label fx:id="lblRecordCount" text="" styleClass="record-count-label"/>
</VBox>
