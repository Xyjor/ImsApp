<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<?import de.jensd.fx.glyphs.fontawesome.FontAwesomeIconView?>

<StackPane xmlns:fx="http://javafx.com/fxml"
           fx:controller="imsapp.controller.LoginController"
           styleClass="login-root"
           stylesheets="@../css/style.css">

    <!-- Centered login card -->
    <VBox styleClass="login-card" spacing="0" maxWidth="400" maxHeight="520"
          alignment="CENTER">

        <!-- Logo + Title -->
        <VBox alignment="CENTER" spacing="10">
            <StackPane styleClass="login-logo-box" maxWidth="52" maxHeight="52">
                <FontAwesomeIconView glyphName="CAR" size="2em" fill="#3b82f6"/>
            </StackPane>
            <Label text="Vehicle &amp; Driver IMS" styleClass="login-title"/>
            <Label text="Information Management System" styleClass="login-subtitle"/>
        </VBox>

        <VBox.margin><Insets bottom="28"/></VBox.margin>

        <!-- Divider -->
        <Separator styleClass="login-divider"/>
        <VBox.margin><Insets top="0" bottom="24"/></VBox.margin>

        <!-- Form -->
        <VBox spacing="16">
            <!-- Username -->
            <VBox spacing="4">
                <Label text="USERNAME" styleClass="login-label"/>
                <TextField fx:id="txtUsername" promptText="Enter your username"
                           styleClass="login-field" maxWidth="Infinity"/>
            </VBox>

            <!-- Password -->
            <VBox spacing="4">
                <Label text="PASSWORD" styleClass="login-label"/>
                <PasswordField fx:id="txtPassword" promptText="Enter your password"
                               styleClass="login-field" maxWidth="Infinity"/>
            </VBox>

            <!-- Error label (hidden by default) -->
            <Label fx:id="lblError" text="" styleClass="login-error"
                   maxWidth="Infinity" visible="false" managed="false"/>

            <!-- Login button -->
            <Button text="Sign In" styleClass="login-btn"
                    onAction="#handleLogin" maxWidth="Infinity"
                    defaultButton="true">
                <graphic><FontAwesomeIconView glyphName="SIGN_IN" fill="white" size="1em"/></graphic>
            </Button>
        </VBox>

        <!-- Footer -->
        <VBox alignment="CENTER" spacing="2">
            <VBox.margin><Insets top="28"/></VBox.margin>
            <Label text="Secure access — SHA-256 protected" styleClass="login-subtitle"/>
            <Label text="© 2026 Xyjor Corporation" styleClass="login-subtitle"/>
        </VBox>

    </VBox>
</StackPane>
