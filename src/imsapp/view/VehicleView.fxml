<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.control.cell.PropertyValueFactory?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<?import com.jfoenix.controls.*?>
<?import de.jensd.fx.glyphs.fontawesome.FontAwesomeIconView?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="imsapp.controller.VehicleController"
      spacing="16" styleClass="module-pane">
    <padding><Insets top="20" right="24" bottom="20" left="24"/></padding>

    <Label text="Vehicle Registration (OR/CR)" styleClass="module-title"/>

    <GridPane hgap="12" vgap="10" styleClass="form-grid">
        <Label text="Owner Details" styleClass="section-header" GridPane.rowIndex="0" GridPane.columnIndex="0" GridPane.columnSpan="4"/>
        
        <Label text="Customer:" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
        <ComboBox fx:id="cmbCustomer" GridPane.rowIndex="1" GridPane.columnIndex="1" prefWidth="250"/>

        <Label text="Vehicle Specifications" styleClass="section-header" GridPane.rowIndex="2" GridPane.columnIndex="0" GridPane.columnSpan="4">
            <GridPane.margin><Insets top="10"/></GridPane.margin>
        </Label>
        
        <Label text="Plate No:" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
        <TextField fx:id="txtPlateNo" GridPane.rowIndex="3" GridPane.columnIndex="1"/>

        <Label text="Make:" GridPane.rowIndex="3" GridPane.columnIndex="2"/>
        <TextField fx:id="txtMake" GridPane.rowIndex="3" GridPane.columnIndex="3"/>
        
        <Label text="Model:" GridPane.rowIndex="4" GridPane.columnIndex="0"/>
        <TextField fx:id="txtModel" GridPane.rowIndex="4" GridPane.columnIndex="1"/>

        <Label text="Year:" GridPane.rowIndex="4" GridPane.columnIndex="2"/>
        <TextField fx:id="txtYear" GridPane.rowIndex="4" GridPane.columnIndex="3"/>
        
        <Label text="Color:" GridPane.rowIndex="5" GridPane.columnIndex="0"/>
        <TextField fx:id="txtColor" GridPane.rowIndex="5" GridPane.columnIndex="1"/>
        
        <Label text="Fuel Type:" GridPane.rowIndex="5" GridPane.columnIndex="2"/>
        <ComboBox fx:id="cmbFuelType" GridPane.rowIndex="5" GridPane.columnIndex="3" prefWidth="200"/>

        <Label text="Registration &amp; Identifiers" styleClass="section-header" GridPane.rowIndex="6" GridPane.columnIndex="0" GridPane.columnSpan="4">
            <GridPane.margin><Insets top="10"/></GridPane.margin>
        </Label>

        <Label text="Engine No:" GridPane.rowIndex="7" GridPane.columnIndex="0"/>
        <TextField fx:id="txtEngineNo" GridPane.rowIndex="7" GridPane.columnIndex="1"/>
        
        <Label text="Chassis No:" GridPane.rowIndex="7" GridPane.columnIndex="2"/>
        <TextField fx:id="txtChassisNo" GridPane.rowIndex="7" GridPane.columnIndex="3"/>

        <Label text="OR No:" GridPane.rowIndex="8" GridPane.columnIndex="0"/>
        <TextField fx:id="txtOrNo" GridPane.rowIndex="8" GridPane.columnIndex="1"/>
        
        <Label text="CR No:" GridPane.rowIndex="8" GridPane.columnIndex="2"/>
        <TextField fx:id="txtCrNo" GridPane.rowIndex="8" GridPane.columnIndex="3"/>

        <Label text="Status:" GridPane.rowIndex="9" GridPane.columnIndex="0"/>
        <ComboBox fx:id="cmbStatus" GridPane.rowIndex="9" GridPane.columnIndex="1" prefWidth="200"/>
    </GridPane>

    <HBox spacing="10" alignment="CENTER_LEFT">
        <Button text=" Save" styleClass="btn-primary" onAction="#handleSave">
            <graphic><FontAwesomeIconView glyphName="SAVE" fill="white"/></graphic>
        </Button>
        <Button text=" Update" styleClass="btn-secondary" onAction="#handleUpdate">
            <graphic><FontAwesomeIconView glyphName="EDIT" fill="#a8b2d1"/></graphic>
        </Button>
        <Button text=" Delete" styleClass="btn-danger" onAction="#handleDelete">
            <graphic><FontAwesomeIconView glyphName="TRASH" fill="#e94560"/></graphic>
        </Button>
        <Button text=" Clear" styleClass="btn-outline" onAction="#handleClear">
            <graphic><FontAwesomeIconView glyphName="ERASER" fill="#8892b0"/></graphic>
        </Button>
        <Button text=" Export CSV" styleClass="btn-secondary" onAction="#handleExport">
            <graphic><FontAwesomeIconView glyphName="FILE_EXCEL_ALT" fill="#a8b2d1"/></graphic>
        </Button>
        <Region HBox.hgrow="ALWAYS"/>
        <HBox alignment="CENTER" spacing="5">
            <FontAwesomeIconView glyphName="SEARCH" fill="#8892b0"/>
            <TextField fx:id="txtSearch" promptText="Search Vehicles..." prefWidth="250"/>
        </HBox>
    </HBox>

    <TableView fx:id="tblVehicles" VBox.vgrow="ALWAYS" styleClass="data-table">
        <placeholder>
            <Label text="No vehicle records found."/>
        </placeholder>
        <columns>
            <TableColumn text="ID" prefWidth="50">
                <cellValueFactory><PropertyValueFactory property="vehicleId"/></cellValueFactory>
            </TableColumn>
            <TableColumn text="Plate No" prefWidth="100">
                <cellValueFactory><PropertyValueFactory property="plateNumber"/></cellValueFactory>
            </TableColumn>
            <TableColumn text="Make" prefWidth="100">
                <cellValueFactory><PropertyValueFactory property="make"/></cellValueFactory>
            </TableColumn>
            <TableColumn text="Model" prefWidth="100">
                <cellValueFactory><PropertyValueFactory property="model"/></cellValueFactory>
            </TableColumn>
            <TableColumn text="Engine No" prefWidth="130">
                <cellValueFactory><PropertyValueFactory property="engineNumber"/></cellValueFactory>
            </TableColumn>
            <TableColumn text="Chassis No" prefWidth="130">
                <cellValueFactory><PropertyValueFactory property="chassisNumber"/></cellValueFactory>
            </TableColumn>
            <TableColumn text="Status" prefWidth="100">
                <cellValueFactory><PropertyValueFactory property="status"/></cellValueFactory>
            </TableColumn>
        </columns>
    </TableView>
</VBox>
