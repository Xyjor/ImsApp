<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<?import com.jfoenix.controls.*?>
<?import de.jensd.fx.glyphs.fontawesome.FontAwesomeIconView?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="imsapp.controller.DashboardController"
            prefWidth="1100" prefHeight="700"
            styleClass="root-pane">

    <!-- LEFT NAVIGATION PANEL -->
    <left>
        <VBox styleClass="nav-panel" spacing="4" prefWidth="220">
            <padding><Insets top="20" right="10" bottom="20" left="10"/></padding>

            <Label text="Vehicle &amp; Driver IMS" styleClass="nav-title"/>
            <Separator/>

            <Separator/>
            
            <Button fx:id="btnCustomers" text=" Customers" styleClass="nav-button"
                    onAction="#handleNavCustomers" maxWidth="Infinity">
                <graphic><FontAwesomeIconView glyphName="USERS" size="1.2em" fill="#a8b2d1"/></graphic>
            </Button>
            <Button fx:id="btnLicenses" text=" Driver's License" styleClass="nav-button"
                    onAction="#handleNavLicenses" maxWidth="Infinity">
                <graphic><FontAwesomeIconView glyphName="ID_CARD" size="1.2em" fill="#a8b2d1"/></graphic>
            </Button>
            <Button fx:id="btnVehicles" text=" Vehicles / OR-CR" styleClass="nav-button"
                    onAction="#handleNavVehicles" maxWidth="Infinity">
                <graphic><FontAwesomeIconView glyphName="CAR" size="1.2em" fill="#a8b2d1"/></graphic>
            </Button>
            <Button fx:id="btnPayments" text=" Payments" styleClass="nav-button"
                    onAction="#handleNavPayments" maxWidth="Infinity">
                <graphic><FontAwesomeIconView glyphName="CREDIT_CARD" size="1.2em" fill="#a8b2d1"/></graphic>
            </Button>

            <Region VBox.vgrow="ALWAYS"/>

            <Button text=" Logout" styleClass="nav-button, logout-button"
                    onAction="#handleLogout" maxWidth="Infinity">
                <graphic><FontAwesomeIconView glyphName="SIGN_OUT" size="1.2em" fill="#ff6b81"/></graphic>
            </Button>

            <Separator/>
            <Label text="© 2026 Xyjor" styleClass="nav-footer"/>
        </VBox>
    </left>

    <!-- CENTER CONTENT AREA (swapped dynamically) -->
    <center>
        <StackPane fx:id="contentArea" styleClass="content-area">
            <!-- Content loaded via Controller -->
        </StackPane>
    </center>
</BorderPane>
