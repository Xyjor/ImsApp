<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.control.cell.PropertyValueFactory?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<?import com.jfoenix.controls.*?>
<?import de.jensd.fx.glyphs.fontawesome.FontAwesomeIconView?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="imsapp.controller.CustomerController"
      spacing="16" styleClass="module-pane">
    <padding><Insets top="20" right="24" bottom="20" left="24"/></padding>

    <Label text="Customer Records" styleClass="module-title"/>

    <!-- FORM -->
    <GridPane hgap="12" vgap="10" styleClass="form-grid">
        <Label text="Personal Information" styleClass="section-header" GridPane.rowIndex="0" GridPane.columnIndex="0" GridPane.columnSpan="4"/>
        
        <Label text="First Name:" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
        <TextField fx:id="txtFirstName" GridPane.rowIndex="1" GridPane.columnIndex="1" prefWidth="200"/>
        <Label text="Last Name:" GridPane.rowIndex="1" GridPane.columnIndex="2"/>
        <TextField fx:id="txtLastName" GridPane.rowIndex="1" GridPane.columnIndex="3" prefWidth="200"/>

        <Label text="Middle Name:" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
        <TextField fx:id="txtMiddleName" GridPane.rowIndex="2" GridPane.columnIndex="1"/>
        <Label text="Gender:" GridPane.rowIndex="2" GridPane.columnIndex="2"/>
        <ComboBox fx:id="cmbGender" GridPane.rowIndex="2" GridPane.columnIndex="3" prefWidth="200"/>

        <Label text="Date of Birth:" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
        <DatePicker fx:id="dpDateOfBirth" GridPane.rowIndex="3" GridPane.columnIndex="1"/>
        
        <Label text="Contact &amp; Address Details" styleClass="section-header" GridPane.rowIndex="4" GridPane.columnIndex="0" GridPane.columnSpan="4">
            <GridPane.margin><Insets top="10"/></GridPane.margin>
        </Label>
        
        <Label text="Contact No:" GridPane.rowIndex="5" GridPane.columnIndex="0"/>
        <TextField fx:id="txtContact" GridPane.rowIndex="5" GridPane.columnIndex="1"/>
        <Label text="Email:" GridPane.rowIndex="5" GridPane.columnIndex="2"/>
        <TextField fx:id="txtEmail" GridPane.rowIndex="5" GridPane.columnIndex="3"/>

        <Label text="Address:" GridPane.rowIndex="6" GridPane.columnIndex="0"/>
        <TextField fx:id="txtAddress" GridPane.rowIndex="6" GridPane.columnIndex="1" GridPane.columnSpan="3"/>

        <Label text="City:" GridPane.rowIndex="7" GridPane.columnIndex="0"/>
        <TextField fx:id="txtCity" GridPane.rowIndex="7" GridPane.columnIndex="1"/>
        <Label text="Province:" GridPane.rowIndex="7" GridPane.columnIndex="2"/>
        <TextField fx:id="txtProvince" GridPane.rowIndex="7" GridPane.columnIndex="3"/>
        
        <Label text="Zip Code:" GridPane.rowIndex="8" GridPane.columnIndex="0"/>
        <TextField fx:id="txtZipCode" GridPane.rowIndex="8" GridPane.columnIndex="1"/>
    </GridPane>

    <!-- BUTTONS & SEARCH -->
    <HBox spacing="10" alignment="CENTER_LEFT">
        <Button text=" Save" styleClass="btn-primary" onAction="#handleSave">
            <graphic><FontAwesomeIconView glyphName="SAVE" fill="white"/></graphic>
        </Button>
        <Button text=" Update" styleClass="btn-secondary" onAction="#handleUpdate">
            <graphic><FontAwesomeIconView glyphName="EDIT" fill="#a8b2d1"/></graphic>
        </Button>
        <Button text=" Delete" styleClass="btn-danger" onAction="#handleDelete">
            <graphic><FontAwesomeIconView glyphName="TRASH" fill="#e94560"/></graphic>
        </Button>
        <Button text=" Clear" styleClass="btn-outline" onAction="#handleClear">
            <graphic><FontAwesomeIconView glyphName="ERASER" fill="#8892b0"/></graphic>
        </Button>
        <Button text=" Export CSV" styleClass="btn-secondary" onAction="#handleExport">
            <graphic><FontAwesomeIconView glyphName="FILE_EXCEL_ALT" fill="#a8b2d1"/></graphic>
        </Button>
        <Region HBox.hgrow="ALWAYS"/>
        <HBox alignment="CENTER" spacing="5">
            <FontAwesomeIconView glyphName="SEARCH" fill="#8892b0"/>
            <TextField fx:id="txtSearch" promptText="Search Customers..." prefWidth="250"/>
        </HBox>
    </HBox>

    <!-- TABLE -->
    <TableView fx:id="tblCustomers" VBox.vgrow="ALWAYS" styleClass="data-table">
        <placeholder>
            <Label text="No customer records found."/>
        </placeholder>
        <columns>
            <TableColumn text="ID" prefWidth="50">
                <cellValueFactory><PropertyValueFactory property="customerId"/></cellValueFactory>
            </TableColumn>
            <TableColumn text="Last Name" prefWidth="120">
                <cellValueFactory><PropertyValueFactory property="lastName"/></cellValueFactory>
            </TableColumn>
            <TableColumn text="First Name" prefWidth="120">
                <cellValueFactory><PropertyValueFactory property="firstName"/></cellValueFactory>
            </TableColumn>
            <TableColumn text="Gender" prefWidth="80">
                <cellValueFactory><PropertyValueFactory property="gender"/></cellValueFactory>
            </TableColumn>
            <TableColumn text="Contact" prefWidth="120">
                <cellValueFactory><PropertyValueFactory property="contactNumber"/></cellValueFactory>
            </TableColumn>
            <TableColumn text="Address" prefWidth="200">
                <cellValueFactory><PropertyValueFactory property="address"/></cellValueFactory>
            </TableColumn>
        </columns>
    </TableView>
</VBox>
